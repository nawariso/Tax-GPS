      "source_id": "RD-RC-SECTION-38-64",
      "verified_at": "2026-09-15",
      "parameters": {
        "standard": "30000.00",
        "additional_legal_child": "30000.00",
        "additional_min_order": 2,
        "additional_min_birth_year": 2018
      },
      "supplementary_source_ids": [
        "RD-DEDUCTION-SCHEDULE"
      ],
      "review_notes": [
        "Legal eligibility is supplied explicitly; this phase does not infer age, education, income, custody, or duplicate-claim conditions.",
        "The published schedule also caps non-legitimate (adopted) children at three; that count restriction is out of scope for this phase and is not enforced here."
      ]
    },
