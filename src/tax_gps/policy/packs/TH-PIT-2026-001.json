      "rule_id": "TH-PIT-ALLOWANCE-SSO-33", "version": "1.0.0", "tax_year": 2026, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "status": "EFFECTIVE", "source_id": "OCS-SSO-WAGE-BASE-2025", "verified_at": "2026-09-15",
      "parameters": {"rate": "0.05", "monthly_wage_floor": "1650.00", "monthly_wage_ceiling": "17500.00", "monthly_maximum": "875.00"}, "supplementary_source_ids": ["THGOV-CABINET-SSO-2025", "RD-RC-SECTION-38-64", "RD-DEDUCTION-SCHEDULE"], "review_notes": ["Tax deduction uses actual contributions paid; the statutory wage base is used only to calculate a contribution when requested.", "The cabinet summary confirms the 17,500 baht ceiling applies to B.E. 2569-2571 (2026-2028), the 1,650 baht floor is unchanged, and the rate remains 5%, giving a 875 baht monthly maximum."]
    },
    {
      "rule_id": "TH-PIT-ALLOWANCE-PARENT", "version": "1.0.0", "tax_year": 2026, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "status": "EFFECTIVE", "source_id": "RD-RC-SECTION-38-64", "verified_at": "2026-09-15",
      "parameters": {"amount_per_eligible_parent": "30000.00"}, "supplementary_source_ids": ["RD-DEDUCTION-SCHEDULE"], "review_notes": ["Eligibility is supplied explicitly; this phase does not infer it.", "The published schedule conditions this allowance on a parent aged 60 or over whose assessable income does not exceed 30,000 baht; those statutory conditions are caller-asserted in this phase."]
    },
    {
      "rule_id": "TH-PIT-ALLOWANCE-CHILD", "version": "1.0.0", "tax_year": 2026, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "status": "EFFECTIVE", "source_id": "RD-RC-SECTION-38-64", "verified_at": "2026-09-15",
      "parameters": {"standard": "30000.00", "additional_legal_child": "30000.00", "additional_min_order": 2, "additional_min_birth_year": 2018}, "supplementary_source_ids": ["RD-DEDUCTION-SCHEDULE"], "review_notes": ["Legal eligibility is supplied explicitly; this phase does not infer age, education, income, custody, or duplicate-claim conditions.", "The published schedule also caps non-legitimate (adopted) children at three; that count restriction is out of scope for this phase and is not enforced here."]
    },
    {
      "rule_id": "TH-PIT-ALLOWANCE-MORTGAGE-INTEREST", "version": "1.0.0", "tax_year": 2026, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "status": "EFFECTIVE", "source_id": "RD-MORTGAGE-2025-INSTRUCTIONS", "verified_at": "2026-09-15",
      "parameters": {"cap": "100000.00"}, "supplementary_source_ids": ["RD-RC-SECTION-38-64", "RD-DEDUCTION-SCHEDULE"], "review_notes": ["The 2025 filing instruction corroborates the cap; no separate 2026 Revenue Department filing instruction was identified as of verification.", "The published allowance schedule independently states the 100,000 baht cap for qualifying housing-loan interest."]
    },
    {
      "rule_id": "TH-PIT-LIMIT-RETIREMENT-SHARED", "version": "1.0.0", "tax_year": 2026, "effective_from": "2026-01-01", "effective_to": "2026-12-31", "status": "EFFECTIVE", "source_id": "RD-RMF-FAQ", "verified_at": "2026-09-15",
      "parameters": {"group_id": "RETIREMENT", "cap": "500000.00"}, "supplementary_source_ids": ["RD-DEDUCTION-SCHEDULE"], "review_notes": ["This phase provides shared-cap accounting only; product-specific eligibility and sublimits are outside scope.", "The published schedule confirms the 500,000 baht combined ceiling across provident fund, GPF, RMF, national savings fund, and pension life insurance."]
    }
